{
  "$schema": "https://raw.githubusercontent.com/fastfetch-cli/fastfetch/2.66.0/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "NixOS",
    "position": "top"
  },
  "display": {
    "separator": "",
    "constants": [
      "\u001b[90m│                                                            │\u001b[60D\u001b[39m"
    ]
  },
  "modules": [
    {
      "type": "custom",
      "key": "{#90}╭ Keys ───────────╮",
      "format": "{#90}╭ Values ────────────────────────────────────────────────────╮"
    },
    {
      "type": "title",
      "key": "{#90}│ {#92}User            {#90}│",
      "format": "{$1}{user-name}  {#2}({home-dir})"
    },
    {
      "type": "datetime",
      "key": "{#90}│ {#92}Datetime        {#90}│",
      "format": "{$1}{year}-{month-pretty}-{day-in-month} {hour-pretty}:{minute-pretty}:{second-pretty}  {#2}[UTC{offset-from-utc}]"
    },
    {
      "type": "title",
      "key": "{#90}│ {#93}Host            {#90}│",
      "format": "{$1}{host-name}"
    },
    {
      "type": "host",
      "key": "{#90}│ {#93}Machine         {#90}│",
      "format": "{$1}{name}"
    },
    {
      "type": "os",
      "key": "{#90}│ {#93}OS              {#90}│",
      "format": "{$1}{name}  {#2}v{version} ({arch})"
    },
    {
      "type": "kernel",
      "key": "{#90}│ {#93}Kernel          {#90}│",
      "format": "{$1}{sysname}  {#2}v{release}"
    },
    {
      "type": "packages",
      "key": "{#90}│ {#93}Packages         {#90}│",
      "format": "{$1}{#2}Nix: {#1}{nix-default}  {#2}Flatpak: {#1}{flatpak-all}"
    },
    {
      "type": "uptime",
      "key": "{#90}│ {#93}Uptime          {#90}│",
      "format": "{$1}{?days}{days} Days + {?}{hours}:{minutes}:{seconds}"
    },
    {
      "type": "cpu",
      "key": "{#90}│ {#91}CPU             {#90}│",
      "showPeCoreCount": true,
      "temp": true,
      "format": "{$1}{name} @ {freq-max}"
    },
    {
      "type": "gpu",
      "key": "{#90}│ {#91}GPU             {#90}│",
      "detectionMethod": "auto",
      "driverSpecific": true,
      "format": "{$1}{vendor} {name} @ {frequency} ({dedicated-total})"
    },
    {
      "type": "memory",
      "key": "{#90}│ {#91}Memory          {#90}│",
      "format": "{$1}{used} / {total} ({percentage})"
    },
    {
      "type": "swap",
      "key": "{#90}│ {#91}Swap            {#90}│",
      "format": "{$1}{used} / {total} ({percentage})"
    },
    {
      "type": "disk",
      "key": "{#90}│ {#91}Disk            {#90}│",
      "format": "{$1}{size-used} / {size-total} ({size-percentage})"
    },
    {
      "type": "poweradapter",
      "key": "{#90}│ {#91}Power           {#90}│",
      "format": "{$1}{name}"
    },
    {
      "type": "wm",
      "key": "{#90}│ {#95}Window Manager  {#90}│",
      "format": "{$1}{pretty-name}  {#2}v{version} ({protocol-name})"
    },
    {
      "type": "shell",
      "key": "{#90}│ {#95}Shell           {#90}│",
      "format": "{$1}{pretty-name}  {#2}v{version}  (PID:{pid})"
    },
    {
      "type": "terminal",
      "key": "{#90}│ {#95}Terminal        {#90}│",
      "format": "{$1}{pretty-name}  {#2}v{version}  (PID:{pid})"
    },
    {
      "type": "terminalfont",
      "key": "{#90}│ {#95}Font            {#90}│",
      "format": "{$1}{name}  {#2}{size}pt"
    },
    {
      "type": "localip",
      "key": "{#90}│ {#94}Local IPv4      {#90}│",
      "showPrefixLen": true,
      "showIpv4": true,
      "showIpv6": false,
      "showMtu": true,
      "format": "{$1}{ifname}: {ipv4}"
    },
    {
      "type": "custom",
      "key": "{#90}╰─────────────────╯",
      "format": "{#90}╰────────────────────────────────────────────────────────────╯"
    }
  ]
}
